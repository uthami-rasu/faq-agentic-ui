API_BASE_URL=http://localhost:8080/api/v1
# Optional server-to-server credential for deployed Next.js. Never prefix with NEXT_PUBLIC_.
BACKEND_SERVICE_TOKEN=

# Development-only Basic authentication used by `./start.sh`.
DEV_AUTH_USER=dev-user
DEV_AUTH_PASSWORD=dev-password

# Set true only when intentionally running the original UI mock data.
NEXT_PUBLIC_USE_MOCK_DATA=false
